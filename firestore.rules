rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function estaLogado() {
      return request.auth != null;
    }

    function possuiCadastro() {
      return estaLogado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function usuarioAtual() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function estaAtivo() {
      return possuiCadastro() && usuarioAtual().ativo == true;
    }

    function ehAdministrador() {
      return estaAtivo() && usuarioAtual().cargo == "administrador";
    }

    function pertenceAoEstabelecimento(estabelecimentoId) {
      return estaAtivo()
        && usuarioAtual().estabelecimentoId == estabelecimentoId;
    }

    function ehCriadorDoSistema() {
      return estaLogado()
        && request.auth.token.email == "adiel.moreirabezerra1@gmail.com";
    }

    match /solicitacoesCadastro/{usuarioId} {
      allow create: if estaLogado()
        && request.auth.uid == usuarioId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pendente";

      allow get: if ehCriadorDoSistema()
        || (estaLogado() && request.auth.uid == usuarioId);

      allow list, update, delete: if ehCriadorDoSistema();
    }

    match /usuarios/{usuarioId} {
      allow read: if estaAtivo()
        && (
          request.auth.uid == usuarioId
          || (
            ehAdministrador()
            && resource.data.estabelecimentoId
              == usuarioAtual().estabelecimentoId
          )
        );

      allow create: if ehAdministrador()
        && request.resource.data.estabelecimentoId
          == usuarioAtual().estabelecimentoId;

      allow update, delete: if ehAdministrador()
        && resource.data.estabelecimentoId
          == usuarioAtual().estabelecimentoId;
    }

    match /estabelecimentos/{estabelecimentoId}/{documento=**} {
      allow read: if pertenceAoEstabelecimento(estabelecimentoId);
      allow write: if pertenceAoEstabelecimento(estabelecimentoId)
        && ehAdministrador();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
